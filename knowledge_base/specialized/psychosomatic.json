    "coping_techniques": {
      "breathing": {
        "name": "호흡법",
        "technique": "4-7-8 호흡: 4초 들이쉬고, 7초 참고, 8초 내쉬기",
        "rationale": "부교감신경 활성화로 신체 진정"
      },
      "grounding": {
        "name": "그라운딩",
        "technique": "5-4-3-2-1: 5가지 보이는 것, 4가지 만지는 것, 3가지 들리는 것, 2가지 냄새, 1가지 맛",
        "rationale": "현재 순간으로 주의 되돌리기"
      },
      "cognitive": {
        "name": "인지적 대처",
        "technique": "'이것은 공황발작이다. 불편하지만 위험하지 않다. 곧 지나갈 것이다.'",
        "rationale": "파국적 해석 교정"
      }
    },
    "helpful_responses": [
      "정말 무서우셨겠어요.",
      "신체 증상이 심해서 공포스러우셨군요.",
      "병원에서 이상 없다고 해도 증상은 실제로 느껴지시잖아요.",
      "공황발작은 불편하지만 위험하지 않아요."
    ]
  },

