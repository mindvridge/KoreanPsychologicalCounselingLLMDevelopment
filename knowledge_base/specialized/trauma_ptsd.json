{
  "category": "트라우마 및 PTSD",
  "version": "1.0",
  "last_updated": "2025-12-13",

  "overview": {
    "definition": "트라우마는 압도적인 스트레스 사건에 대한 심리적/생리적 반응이며, PTSD는 트라우마 이후 지속되는 증상 장애입니다.",
    "prevalence_korea": "한국 성인 PTSD 유병률 약 1.5-3%, 복합 트라우마 경험자 더 높음",
    "common_causes_korea": [
      "가정폭력/아동학대",
      "성폭력/성희롱",
      "직장 내 괴롭힘",
      "교통사고",
      "재난 경험",
      "군 복무 중 트라우마",
      "의료 트라우마"
    ]
  },

  "symptoms": {
    "intrusion": {
      "name": "재경험/침습",
      "examples": [
        "악몽",
        "플래시백",
        "트라우마 관련 자극에 대한 심한 정서적 반응",
        "트라우마 생각의 반복적 떠오름"
      ],
      "helpful_responses": [
        "그 기억이 자꾸 떠오르시는군요. 정말 힘드시겠어요.",
        "플래시백이 있으셨군요. 지금 이 순간은 안전해요.",
        "과거가 현재처럼 느껴지실 때 정말 무서우셨겠어요."
      ]
    },
    "avoidance": {
      "name": "회피",
      "examples": [
        "트라우마 관련 장소/사람/상황 피함",
        "트라우마에 대해 생각하거나 말하기 거부",
        "감정적 무감각"
      ],
      "helpful_responses": [
        "그 상황을 피하고 싶으신 마음이 이해돼요.",
        "말씀하시기 어려우시면 천천히 하셔도 돼요.",
        "회피는 자연스러운 보호 반응이에요."
      ]
    },
    "negative_cognition": {
      "name": "부정적 인지와 기분",
      "examples": [
        "자기 비난 ('내 잘못이야')",
        "세상에 대한 불신",
        "지속적인 부정적 감정 (공포, 수치심, 죄책감)",
        "흥미 상실"
      ],
      "helpful_responses": [
        "자신을 탓하시는 마음이 느껴지네요. 그건 당신 잘못이 아니에요.",
        "그 일 이후로 세상이 다르게 느껴지시는군요.",
        "수치심을 느끼시는 건 흔한 반응이에요. 하지만 당신은 잘못하신 게 없어요."
      ]
    },
    "hyperarousal": {
      "name": "과각성",
      "examples": [
        "과도한 경계심",
        "쉽게 놀람",
        "수면 문제",
        "집중력 저하",
        "과민성/분노 폭발"
      ],
      "helpful_responses": [
        "항상 경계하고 계시느라 지치셨겠어요.",
        "작은 소리에도 놀라시는군요. 몸이 아직 위험 모드에 있는 것 같아요.",
        "잠을 못 주무시면 정말 힘드시죠."
      ]
    }
  },

  "therapeutic_approaches": {
    "trauma_informed_care": {
      "name": "트라우마 정보 기반 접근",
      "principles": [
        "안전: 물리적/정서적 안전 확보",
        "신뢰성: 일관되고 예측 가능한 관계",
        "선택권: 내담자의 통제감 존중",
        "협력: 동등한 파트너십",
        "역량 강화: 강점 기반 접근"
      ],
      "ai_application": [
        "안전한 공간임을 자주 상기시키기",
        "내담자의 속도 존중",
        "선택지 제공하기",
        "강점과 회복력 인정하기"
      ]
    },
    "grounding_techniques": {
      "name": "그라운딩 기법",
      "techniques": [
        {
          "name": "5-4-3-2-1 기법",
          "description": "5가지 볼 수 있는 것, 4가지 만질 수 있는 것, 3가지 들을 수 있는 것, 2가지 냄새 맡을 수 있는 것, 1가지 맛볼 수 있는 것",
          "when_to_use": "플래시백, 해리, 공황 상황"
        },
        {
          "name": "발 느끼기",
          "description": "발이 바닥에 닿은 느낌에 집중하기",
          "when_to_use": "가벼운 해리, 불안 고조 시"
        },
        {
          "name": "냉수/얼음",
          "description": "차가운 물로 손 씻기, 얼음 쥐기",
          "when_to_use": "강렬한 감정 상태, 해리"
        }
      ]
    },
    "stabilization": {
      "name": "안정화",
      "goals": [
        "안전 확보",
        "증상 관리 능력 향상",
        "일상 기능 회복",
        "지지체계 구축"
      ],
      "important_note": "AI 상담에서는 안정화에 초점, 트라우마 직접 처리는 전문가에게 의뢰"
    }
  },

  "safety_considerations": {
    "triggers": {
      "description": "트라우마 관련 주제가 촉발자가 될 수 있음",
      "ai_guidelines": [
        "트라우마 세부 사항 깊이 탐색하지 않기",
        "현재 안전 상태 자주 확인",
        "압도되면 멈출 수 있음을 안내"
      ]
    },
    "professional_referral": {
      "when_to_refer": [
        "심각한 해리 증상",
        "자해/자살 사고",
        "일상 기능 심각 저하",
        "물질 남용 동반",
        "복합 트라우마"
      ],
      "resources": [
        "트라우마 전문 상담센터",
        "EMDR 전문 치료사",
        "정신건강의학과"
      ]
    }
  },

  "helpful_phrases": {
    "validation": [
      "겪으신 일이 정말 힘드셨을 것 같아요.",
      "그런 경험 후에 그렇게 느끼시는 건 자연스러운 반응이에요.",
      "당신 잘못이 아니에요.",
      "살아남으신 것만으로도 대단하세요."
    ],
    "safety": [
      "지금 이 순간은 안전해요.",
      "과거의 일이고, 지금은 여기 계세요.",
      "천천히 호흡해 볼까요?",
      "여기서 함께 있어요."
    ],
    "empowerment": [
      "어떻게 하고 싶으세요?",
      "당신이 원하는 속도로 진행해도 돼요.",
      "언제든 멈출 수 있어요.",
      "당신은 이미 많은 것을 이겨내셨어요."
    ]
  }
