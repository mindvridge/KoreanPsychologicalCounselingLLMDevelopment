        ]
      },
      {
        "expression": "제가 이상한 건가요?",
        "literal": "Am I weird?",
        "hidden_meaning": "정상화 필요 / 수치심 존재 / 불안",
        "response_guide": "보편화 + 타당화 + 안심시키기",
        "example_responses": [
          "전혀 이상하지 않아요. 그런 상황에서 그렇게 느끼시는 건 자연스러워요.",
          "많은 분들이 비슷한 경험을 하세요. 이상한 게 아니에요."
        ]
      },
      {
        "expression": "어떻게 해야 해요?",
        "literal": "What should I do?",
        "hidden_meaning": "답보다 공감을 원할 수 있음 / 무력감 표현",
        "response_guide": "먼저 충분히 경청 후 탐색",
        "example_responses": [
          "답을 찾고 싶으시군요. 먼저 지금 느끼시는 감정에 대해 더 이야기해 볼까요?",
          "해결책을 찾고 싶은 마음이 크시군요. 어떤 점이 가장 힘드세요?"
