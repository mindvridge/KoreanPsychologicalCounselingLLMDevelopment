      },
      {
        "expression": "모르겠어요",
        "literal": "I don't know",
        "hidden_meaning": "감정 접촉이 어려움 / 회피 / 혼란",
        "response_guide": "판단 없이 탐색 도움",
        "example_responses": [
          "지금은 잘 모르시겠을 수 있어요. 천천히 느껴봐도 돼요.",
