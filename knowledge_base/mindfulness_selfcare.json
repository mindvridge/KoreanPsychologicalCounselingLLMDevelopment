  "breathing_exercises": [
    {
      "id": "basic_breath",
      "name": "기본 호흡법",
      "duration": "3분",
      "suitable_for": ["불안", "스트레스", "긴장"],
      "script": [
        "편안한 자세로 앉거나 누워주세요.",
        "눈을 감고, 천천히 숨을 들이쉬세요.",
        "하나... 둘... 셋... 넷...",
        "이제 잠시 멈추세요.",
        "하나... 둘...",
        "그리고 천천히 내쉬세요.",
        "하나... 둘... 셋... 넷... 다섯... 여섯...",
        "들숨에는 신선한 공기와 평온함이 들어오고,",
        "날숨에는 긴장과 걱정이 빠져나갑니다.",
        "자신만의 속도로 이 호흡을 계속해 보세요."
      ]
    },
    {
      "id": "478_breath",
      "name": "4-7-8 호흡법",
      "duration": "5분",
      "suitable_for": ["수면 전", "심한 불안", "공황"],
      "script": [
        "편안하게 앉아서 혀끝을 윗니 뒤에 가볍게 대세요.",
        "이제 코로 4초 동안 천천히 숨을 들이쉽니다.",
        "하나... 둘... 셋... 넷...",
        "숨을 참고 7초를 셉니다.",
        "하나... 둘... 셋... 넷... 다섯... 여섯... 일곱...",
        "입으로 8초 동안 '후우' 소리와 함께 내쉽니다.",
        "하나... 둘... 셋... 넷... 다섯... 여섯... 일곱... 여덟...",
        "이것이 한 사이클입니다.",
        "이 호흡을 4회 반복해 보세요.",
        "점점 마음이 차분해지는 것을 느껴보세요."
      ]
    },
    {
      "id": "box_breath",
      "name": "사각형 호흡법 (박스 브리딩)",
      "duration": "4분",
      "suitable_for": ["집중력", "긴장 완화", "마음 정리"],
      "script": [
        "사각형을 떠올려 보세요.",
        "첫 번째 변: 4초 동안 들이쉽니다.",
        "하나... 둘... 셋... 넷...",
        "두 번째 변: 4초 동안 숨을 참습니다.",
        "하나... 둘... 셋... 넷...",
        "세 번째 변: 4초 동안 내쉽니다.",
        "하나... 둘... 셋... 넷...",
        "네 번째 변: 4초 동안 숨을 비워둡니다.",
        "하나... 둘... 셋... 넷...",
        "이 사각형 호흡을 여러 번 반복하세요.",
        "규칙적인 리듬이 마음을 안정시켜 줄 거예요."
      ]
    }
  ],
  "grounding_exercises": [
    {
      "id": "54321",
      "name": "5-4-3-2-1 기법",
      "duration": "3-5분",
      "suitable_for": ["공황", "해리", "불안", "플래시백"],
      "script": [
        "지금 이 순간으로 돌아와 볼게요.",
        "",
        "먼저, 주변에서 눈에 보이는 것 5가지를 찾아보세요.",
        "무엇이 보이나요? 천천히 말해보세요.",
        "",
        "이제, 지금 만지거나 느낄 수 있는 것 4가지를 찾아보세요.",
        "의자의 질감, 옷의 느낌, 발 아래 바닥...",
        "",
        "다음으로, 지금 들리는 소리 3가지에 집중해 보세요.",
        "어떤 소리가 들리나요?",
        "",
        "이번엔, 지금 맡을 수 있는 냄새 2가지를 찾아보세요.",
        "",
        "마지막으로, 지금 맛볼 수 있는 것 1가지를 느껴보세요.",
        "입 안의 느낌이라도 괜찮아요.",
        "",
        "당신은 지금 여기, 안전한 곳에 있습니다."
      ]
    },
    {
      "id": "feet_ground",
      "name": "발바닥 접지 기법",
      "duration": "2분",
      "suitable_for": ["불안", "긴장", "현실감 상실"],
      "script": [
        "잠시 앉거나 서서, 발바닥에 집중해 보세요.",
        "발이 바닥에 닿은 느낌을 느껴보세요.",
        "발가락 하나하나의 느낌...",
        "발바닥 가운데...",
        "발뒤꿈치...",
        "바닥의 온도는 어떤가요? 차갑나요, 따뜻한가요?",
        "바닥은 딱딱한가요, 부드러운가요?",
        "당신의 몸무게가 땅에 단단히 연결되어 있음을 느껴보세요.",
        "당신은 여기에 안전하게 서 있습니다."
      ]
    },
    {
      "id": "cold_water",
      "name": "찬물 기법",
      "duration": "1분",
      "suitable_for": ["공황", "강한 정서적 각성", "해리"],
      "script": [
        "찬물에 손을 담그거나, 찬물로 얼굴을 적셔보세요.",
        "차가운 감각에 집중해 보세요.",
        "이 차가움이 당신을 지금 이 순간으로 데려옵니다.",
        "천천히 숨을 쉬면서, 감각에 집중하세요.",
        "당신은 지금 여기 있습니다."
      ]
    }
  ],
  "body_scan": {
