# Korean Mental Health Counseling API Configuration
# Copy this file to .env and update with your settings

# ============================================================================
# API Server Configuration
# ============================================================================

# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# Enable auto-reload for development (set to false in production)
RELOAD=false

# API Key for authentication (leave empty to disable authentication)
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Allowed CORS origins (comma-separated)
# Use "*" for development, specific domains for production
ALLOWED_ORIGINS=*

# ============================================================================
# System Configuration
# ============================================================================

# Path to configuration file
CONFIG_PATH=configs/config.yaml

# Application mode: api, gradio, or both
APP_MODE=api

# ============================================================================
# Model Configuration
# ============================================================================

# Model name
MODEL_NAME=beomi/OPEN-SOLAR-KO-10.7B

# Enable 4-bit quantization (reduces memory usage)
LOAD_IN_4BIT=true

# Maximum GPU memory per device (e.g., "40GB")
MAX_MEMORY=40GB

# Device map for model loading
DEVICE_MAP=auto

# ============================================================================
# CUDA/GPU Configuration
# ============================================================================

# Visible CUDA devices (e.g., "0,1" for GPUs 0 and 1)
CUDA_VISIBLE_DEVICES=0

# Enable CUDA (set to false for CPU-only mode)
CUDA_ENABLED=true

# ============================================================================
# Database Configuration (Long-term Memory)
# ============================================================================

# Database URL for long-term conversation storage
# SQLite (default, local file):
DATABASE_URL=sqlite:///./data/mental_health.db
DATABASE_PATH=./data/mental_health.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/mental_health

# Enable long-term memory features
ENABLE_LONG_TERM_MEMORY=true

# User data retention period (days)
USER_DATA_RETENTION_DAYS=90

# Redis connection for session management and caching (optional)
# REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Logging Configuration
# ============================================================================

# Log directory
LOG_DIR=./logs

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable encryption for logs (PIPA compliance)
ENABLE_LOG_ENCRYPTION=true

# Log retention period in days
LOG_RETENTION_DAYS=90

# Mask PII in logs
MASK_PII=true

# Encryption key for logs (leave empty to auto-generate)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOG_ENCRYPTION_KEY=

# ============================================================================
# Monitoring Configuration
# ============================================================================

# Enable monitoring
MONITORING_ENABLED=true

# Metrics retention period in days
METRICS_RETENTION_DAYS=30

# Prometheus pushgateway URL (optional)
# PROMETHEUS_PUSHGATEWAY=http://localhost:9091

# ============================================================================
# RAG System Configuration
# ============================================================================

# Knowledge base directory
KNOWLEDGE_BASE_DIR=./knowledge_base

# Embedding model for RAG
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask

# Chunk size for document splitting
CHUNK_SIZE=500

# Chunk overlap
CHUNK_OVERLAP=50

# Maximum results to retrieve
RAG_MAX_RESULTS=3

# ============================================================================
# Safety Configuration
# ============================================================================

# Crisis detection threshold (0.0-1.0)
CRISIS_THRESHOLD=0.7

# Auto-alert professionals on crisis detection
AUTO_ALERT_PROFESSIONALS=false

# Log all conversations (required for compliance)
LOG_ALL_CONVERSATIONS=true

# ============================================================================
# Rate Limiting
# ============================================================================

# Requests per minute for chat endpoint
CHAT_RATE_LIMIT=100

# Requests per minute for assessment endpoint
ASSESSMENT_RATE_LIMIT=20

# Requests per minute for feedback endpoint
FEEDBACK_RATE_LIMIT=50

# ============================================================================
# API Timeouts
# ============================================================================

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Maximum conversation history length
MAX_CONVERSATION_LENGTH=20

# ============================================================================
# Feature Flags
# ============================================================================

# Enable emotion analysis
ENABLE_EMOTION_ANALYSIS=true

# Enable crisis detection
ENABLE_CRISIS_DETECTION=true

# Enable RAG system
ENABLE_RAG=true

# Enable assessments
ENABLE_ASSESSMENTS=true

# ============================================================================
# Enhanced Features (신규 모듈)
# ============================================================================

# Enable enhanced RAG with query rewriting
ENABLE_ENHANCED_RAG=true

# Enable response validation
ENABLE_RESPONSE_VALIDATION=true

# Enable conversation state management
ENABLE_CONVERSATION_STATE=true

# Enable LLM evaluation system
ENABLE_EVALUATION=true

# Enable A/B testing framework
ENABLE_EXPERIMENTS=true

# Enable monitoring dashboard
ENABLE_MONITORING_DASHBOARD=true

# ============================================================================
# Fine-tuning Configuration
# ============================================================================

# Fine-tuning output directory
FINETUNING_OUTPUT_DIR=./outputs/finetuned_model

# Fine-tuning method (qlora, lora, full)
FINETUNING_METHOD=qlora

# LoRA rank
LORA_R=16

# LoRA alpha
LORA_ALPHA=32

# Weights & Biases (optional)
WANDB_PROJECT=
WANDB_API_KEY=

# ============================================================================
# Dashboard & Alerts
# ============================================================================

# Dashboard update interval (seconds)
DASHBOARD_UPDATE_INTERVAL=30

# Alert cooldown (minutes)
ALERT_COOLDOWN_MINUTES=5

# Slack webhook for alerts (optional)
SLACK_WEBHOOK_URL=

# Email alerts (optional)
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ============================================================================
# Development/Debug Settings
# ============================================================================

# Enable debug mode (verbose logging)
DEBUG=false

# Skip model loading for testing (API will run but not function)
SKIP_MODEL_LOADING=false

# Mock responses for testing
MOCK_RESPONSES=false

# ============================================================================
# OpenAI API Configuration (테스트용)
# ============================================================================

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI Model
# gpt-4o: 최고 성능 (비용 높음)
# gpt-4o-mini: 권장 (저비용, 고성능)
# gpt-4-turbo: 고성능
# gpt-3.5-turbo: 최저비용
OPENAI_MODEL=gpt-4o-mini

# LLM Provider (openai, local, mock)
LLM_PROVIDER=openai

# 비용 추적 활성화
OPENAI_TRACK_COST=true

# ============================================================================
# HuggingFace Configuration (로컬 LLM용)
# ============================================================================

# HuggingFace Token (모델 다운로드용)
HUGGINGFACE_TOKEN=hf_your_token_here
