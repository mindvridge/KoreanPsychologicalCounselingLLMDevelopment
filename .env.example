# 한국형 심리상담 LLM 환경 변수 설정

# Model Configuration
MODEL_NAME=beomi/OPEN-SOLAR-KO-10.7B
MODEL_CACHE_DIR=./models
USE_4BIT_QUANTIZATION=true

# GPU Configuration
CUDA_VISIBLE_DEVICES=0
MAX_GPU_MEMORY=80GB

# Generation Parameters
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9
DEFAULT_MAX_TOKENS=512
DEFAULT_REPETITION_PENALTY=1.1

# Conversation Settings
MAX_CONVERSATION_TURNS=10
CONVERSATION_SUMMARY_THRESHOLD=8

# Safety System
ENABLE_CRISIS_DETECTION=true
CRISIS_ALERT_THRESHOLD=0.8

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/korean_mental_health_llm.log

# API Settings (Optional)
API_HOST=0.0.0.0
API_PORT=8000

# Emergency Contact Information
CRISIS_HOTLINE=1577-0199
SUICIDE_PREVENTION_HOTLINE=1393
