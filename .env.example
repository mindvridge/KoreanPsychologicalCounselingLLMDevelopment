# Korean Mental Health Counseling API Configuration
# Copy this file to .env and update with your settings

# ============================================================================
# API Server Configuration
# ============================================================================

# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# Enable auto-reload for development (set to false in production)
RELOAD=false

# API Key for authentication (leave empty to disable authentication)
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Allowed CORS origins (comma-separated)
# Use "*" for development, specific domains for production
ALLOWED_ORIGINS=*

# ============================================================================
# System Configuration
# ============================================================================

# Path to configuration file
CONFIG_PATH=configs/config.yaml

# Application mode: api, gradio, or both
APP_MODE=api

# ============================================================================
# Model Configuration
# ============================================================================

# Model name
MODEL_NAME=beomi/OPEN-SOLAR-KO-10.7B

# Enable 4-bit quantization (reduces memory usage)
LOAD_IN_4BIT=true

# Maximum GPU memory per device (e.g., "40GB")
MAX_MEMORY=40GB

# Device map for model loading
DEVICE_MAP=auto

# ============================================================================
# CUDA/GPU Configuration
# ============================================================================

# Visible CUDA devices (e.g., "0,1" for GPUs 0 and 1)
CUDA_VISIBLE_DEVICES=0

# Enable CUDA (set to false for CPU-only mode)
CUDA_ENABLED=true

# ============================================================================
# Database Configuration (Optional)
# ============================================================================

# PostgreSQL connection string for conversation history
# DATABASE_URL=postgresql://user:password@localhost:5432/mental_health

# Redis connection for session management and caching
# REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Logging Configuration
# ============================================================================

# Log directory
LOG_DIR=./logs

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable encryption for logs (PIPA compliance)
ENABLE_LOG_ENCRYPTION=true

# Log retention period in days
LOG_RETENTION_DAYS=90

# Mask PII in logs
MASK_PII=true

# Encryption key for logs (leave empty to auto-generate)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOG_ENCRYPTION_KEY=

# ============================================================================
# Monitoring Configuration
# ============================================================================

# Enable monitoring
MONITORING_ENABLED=true

# Metrics retention period in days
METRICS_RETENTION_DAYS=30

# Prometheus pushgateway URL (optional)
# PROMETHEUS_PUSHGATEWAY=http://localhost:9091

# ============================================================================
# RAG System Configuration
# ============================================================================

# Knowledge base directory
KNOWLEDGE_BASE_DIR=./knowledge_base

# Embedding model for RAG
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask

# Chunk size for document splitting
CHUNK_SIZE=500

# Chunk overlap
CHUNK_OVERLAP=50

# Maximum results to retrieve
RAG_MAX_RESULTS=3

# ============================================================================
# Safety Configuration
# ============================================================================

# Crisis detection threshold (0.0-1.0)
CRISIS_THRESHOLD=0.7

# Auto-alert professionals on crisis detection
AUTO_ALERT_PROFESSIONALS=false

# Log all conversations (required for compliance)
LOG_ALL_CONVERSATIONS=true

# ============================================================================
# Rate Limiting
# ============================================================================

# Requests per minute for chat endpoint
CHAT_RATE_LIMIT=100

# Requests per minute for assessment endpoint
ASSESSMENT_RATE_LIMIT=20

# Requests per minute for feedback endpoint
FEEDBACK_RATE_LIMIT=50

# ============================================================================
# API Timeouts
# ============================================================================

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Maximum conversation history length
MAX_CONVERSATION_LENGTH=20

# ============================================================================
# Feature Flags
# ============================================================================

# Enable emotion analysis
ENABLE_EMOTION_ANALYSIS=true

# Enable crisis detection
ENABLE_CRISIS_DETECTION=true

# Enable RAG system
ENABLE_RAG=true

# Enable assessments
ENABLE_ASSESSMENTS=true

# ============================================================================
# Development/Debug Settings
# ============================================================================

# Enable debug mode (verbose logging)
DEBUG=false

# Skip model loading for testing (API will run but not function)
SKIP_MODEL_LOADING=false

# Mock responses for testing
MOCK_RESPONSES=false
